{
  "name": "DRC.Geo — Atlas de la République démocratique du Congo",
  "short_name": "DRC.Geo",
  "description": "Les 26 provinces, 145 territoires et 44 villes de la RDC : population, langues, ressources, parcs nationaux et histoire. Fonctionne hors ligne.",
  "lang": "fr",
  "dir": "ltr",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#05100E",
  "theme_color": "#071613",
  "categories": ["education", "reference", "travel", "maps"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "handle_links": "preferred",
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-192-maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "/screenshots/desktop-map.png", "sizes": "1920x1080", "type": "image/png",
      "form_factor": "wide", "label": "La carte des 26 provinces" },
    { "src": "/screenshots/desktop-parks.png", "sizes": "1920x1080", "type": "image/png",
      "form_factor": "wide", "label": "Les 9 parcs nationaux" },
    { "src": "/screenshots/desktop-history.png", "sizes": "1920x1080", "type": "image/png",
      "form_factor": "wide", "label": "Un siècle de frontières" },
    { "src": "/screenshots/phone-map.png", "sizes": "1080x1920", "type": "image/png",
      "form_factor": "narrow", "label": "La carte" },
    { "src": "/screenshots/phone-place.png", "sizes": "1080x1920", "type": "image/png",
      "form_factor": "narrow", "label": "La fiche d'un territoire" },
    { "src": "/screenshots/phone-quiz.png", "sizes": "1080x1920", "type": "image/png",
      "form_factor": "narrow", "label": "Le quiz" }
  ],
  "shortcuts": [
    { "name": "Parcs nationaux", "short_name": "Parcs", "url": "/?layer=parks",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Tester mes connaissances", "short_name": "Quiz", "url": "/?quiz=1",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Histoire & hymnes", "short_name": "Histoire", "url": "/?layer=histoire",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
